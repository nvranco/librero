# Postgres. En Railway se referencia el servicio: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/librero

# Token de la pantalla /admin/{token}. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=cambiame

# Donde viven las fotos. En Railway es el mount del volumen.
DATA_DIR=/data

# Dia 2 (pipeline de vision). Declaradas ya para no tocar config despues.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Solo local. Railway inyecta PORT.
PORT=8000
