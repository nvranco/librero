# Postgres. En Railway se referencia el servicio: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/librero

# Token de la pantalla /admin/{token}. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=cambiame

# Donde viven las fotos. En Railway es el mount del volumen.
DATA_DIR=/data

# Dia 2 (pipeline de vision). Declaradas ya para no tocar config despues.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Replay de las conversaciones de Funes. Es la key PUBLICA (phc_...): viaja en
# el fuente de la pagina y solo puede escribir eventos. Vacia = no se carga
# nada. En produccion se setea; en local se deja vacia a proposito, y ademas el
# proyecto tiene la grabacion restringida al dominio de produccion.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Solo local. Railway inyecta PORT.
PORT=8000

# El dominio propio de Funes, sin esquema. Cuando esta puesto, las paginas del
# recomendador que se comparten (el chat, la privacidad y el QR) se redirigen
# ahi desde cualquier otro host, y la raiz de ese dominio abre el chat. LIBRERO
# no se toca: sigue contestando donde siempre. En local se deja VACIA, o el
# banco y el navegador terminan mandados a produccion.
DOMINIO_FUNES=
